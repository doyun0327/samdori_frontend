# ── 로컬 개발 ──────────────────────────────────────────
# npm run dev → .env.development (localhost)
#
# VITE_API_BASE_URL=http://localhost:8080

# ── Cloudflare Workers (master 운영 배포) ──────────────
# URL: https://samdorifrontend.idoyun781.workers.dev
#
# Build command:
#   npm ci --prefix samdori-front && npm run build --prefix samdori-front
# Deploy command:
#   npm run deploy --prefix samdori-front
#
# API token 권한 필요:
#   Account > Workers Scripts > Edit
#   Account > Account Settings > Read
#
# Production branch: master
# Environment variables (Production):
# VITE_API_BASE_URL=https://api.yourdomain.com
