# ── 로컬 개발 ──────────────────────────────────────────
# npm run dev → .env.development (localhost)
#
# VITE_API_BASE_URL=http://localhost:8080

# ── Cloudflare Pages (master 운영 배포) ────────────────
# Root directory 항목이 없을 때 → Build/Deploy command에 경로 포함
#
# Build command:
#   npm ci --prefix samdori-front && npm run build --prefix samdori-front
# Deploy command:
#   npm run deploy --prefix samdori-front
# Build output directory:
#   samdori-front/dist
# Production branch: master
#
# (Root directory 항목이 있으면 samdori-front 로 설정 후
#  Build: npm run build / Deploy: npm run deploy / Output: dist)
#
# Environment variables (Production):
# VITE_API_BASE_URL=https://api.yourdomain.com
